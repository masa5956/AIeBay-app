# サーバー設定
PORT=3001

# CORSで許可する追加オリジン（カンマ区切り）。localhost:5173と本番Vercel URLは常に許可されるため、
# カスタムドメイン等を追加する場合のみ設定する。
ALLOWED_ORIGINS=""

# Supabase設定（出品履歴DB・商品画像ホスティング用。https://supabase.com でプロジェクト作成後、
# Project Settings > API から取得。SUPABASE_SERVICE_ROLE_KEYはバックエンド専用の管理者権限キーのため
# 絶対にフロントエンドや公開リポジトリに含めないこと）
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# フロントエンド用Supabase設定（アプリのアカウント作成・ログイン画面で使用）。
# VITE_SUPABASE_URLはSUPABASE_URLと同じ値でよい。VITE_SUPABASE_ANON_KEYは
# publishable/anonキー（公開しても安全なキー、service_role/secretキーとは別物）。
# Vite経由でフロントエンドのビルドに埋め込まれるため、ローカルは.envに、
# Vercelはプロジェクトの環境変数に設定する。
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# AIエンジン切替設定（gemini または groq。画像解析(vision)に使うエンジン。未設定時はgemini）
AI_PROVIDER="gemini"
# テキストのみのエージェント（市場トレンド分析・競合比較。画像不要）専用のエンジン指定（任意）。
# 未設定時はAI_PROVIDERと同じものを使う。groqにすると1出品あたりのGemini呼び出し回数を
# 4回→2回に減らせる（基本抽出・商品状態はvisionが必要なためAI_PROVIDER側のまま）。
TEXT_AI_PROVIDER="groq"

# Gemini API設定
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash" # 無料枠のRPD(1日の上限)が低い(実測20)。日次上限に達したら"gemini-3.5-flash-lite"
                                 # (実測RPD 500)に一時切替すると別枠クォータですぐ使える。ただしGoogle検索
                                 # グラウンディング(価格調査)は別クォータのようで、モデル切替では回復しないことがある。

# Groq API設定（AI_PROVIDER=groq または TEXT_AI_PROVIDER=groq のときに使用。https://console.groq.com/keys で取得）
GROQ_API_KEY=""
GROQ_MODEL="qwen/qwen3.6-27b" # 画像解析(vision)用。Groqのラインナップ変更が多いためgroq.models.list()で要再確認
GROQ_TEXT_MODEL="llama-3.3-70b-versatile" # テキストのみのエージェント用（未設定時はGROQ_MODELにフォールバック）

# eBay API設定。Sandbox/Productionを設定タブから即時切替できるよう、キーセットは環境ごとに分けて
# 両方設定しておく（1ユーザーが両方を同時に接続可能。Productionが未取得ならSandboxのみでも動作する）。
EBAY_SANDBOX_CLIENT_ID=""
EBAY_SANDBOX_CLIENT_SECRET=""
EBAY_SANDBOX_RU_NAME=""
EBAY_PRODUCTION_CLIENT_ID=""
EBAY_PRODUCTION_CLIENT_SECRET=""
EBAY_PRODUCTION_RU_NAME=""

# npm run setup:policies のローカル手動実行専用フォールバック（通常の出品では未使用）。
# EBAY_ENVで対象環境を切り替える（"SANDBOX" または "PRODUCTION"、未設定時SANDBOX）。
EBAY_USER_REFRESH_TOKEN=""
EBAY_ENV="SANDBOX"

EBAY_MERCHANT_LOCATION_KEY="DEFAULT_LOCATION" # Sell Inventory APIで使う出荷元ロケーションキー（事前に作成が必要）

# Business Policies（npm run setup:policies で自動取得・保存される）
EBAY_FULFILLMENT_POLICY_ID=""
EBAY_RETURN_POLICY_ID=""
EBAY_PAYMENT_POLICY_ID="" # EBAY_USはManaged Payments必須のため通常は空のままでよい

# 出荷元ロケーション（EBAY_MERCHANT_LOCATION_KEYが未作成の場合、npm run setup:policies で新規作成に使う住所）
EBAY_LOCATION_ADDRESS_LINE1=""
EBAY_LOCATION_CITY=""
EBAY_LOCATION_STATE_OR_PROVINCE=""
EBAY_LOCATION_POSTAL_CODE=""
EBAY_LOCATION_COUNTRY="US"

# eBay Marketplace Account Deletion/Closure通知（本番運用の必須コンプライアンス対応）。
# EBAY_DELETION_VERIFICATION_TOKENは32〜80文字の英数字(_-可)を自分で生成して設定し、
# eBay Developer PortalのNotifications設定にも同じ値を登録する。
# EBAY_DELETION_ENDPOINT_URLはこのサーバーの公開URL+/api/ebay/deletion-notification
# （例: https://ebay-ai-lister-backend.onrender.com/api/ebay/deletion-notification）。
EBAY_DELETION_VERIFICATION_TOKEN=""
EBAY_DELETION_ENDPOINT_URL=""

# リサーチタブ（カテゴリ別/キーワード検索の最新ニュース）用ニュースAPI。
# 無料枠でも商用利用が明示的に許可されているCurrents APIを使用（GNews/Mediastack等の無料枠は
# 非商用限定、Googleニュース検索RSSも個人利用限定、NewsData.ioは商用利用可だが200クレジット/日・
# 12時間遅延と本サービスより見劣りするため不採用）。
# 取得手順: https://currentsapi.services/ でサインアップ（クレカ不要）→ログイン後の
# ダッシュボードにAPIキーが表示されるのでコピーして設定する。
# 無料枠は1,000リクエスト/日、配信遅延は原則なし。
CURRENTS_API_KEY=""
